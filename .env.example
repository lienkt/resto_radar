# Copy to .env (gitignored) and fill in locally. Agents must never read or write .env.
# Production values live in the hosting platform's secret manager.
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resto_radar
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=resto-radar-snapshots
S3_ACCESS_KEY=
S3_SECRET_KEY=
ANTHROPIC_API_KEY=
LLM_DAILY_BUDGET_EUR=5
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
EXPO_ACCESS_TOKEN=
SENTRY_DSN=
CRAWLER_USER_AGENT="RestoRadarBot/0.1 (+https://example.com/bot)"
